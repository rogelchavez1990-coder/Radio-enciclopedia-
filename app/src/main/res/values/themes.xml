<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RadioEnciclopedia" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/radio_deep</item>
        <item name="android:colorBackground">@color/radio_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:textColorPrimary">@color/radio_white</item>
        <item name="android:fontFamily">@font/source_sans_regular</item>
        <item name="android:colorAccent">@color/radio_purple</item>
        <item name="android:alertDialogTheme">@style/Theme.RadioEnciclopedia.Dialog</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.RadioEnciclopedia.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorBackground">#241239</item>
        <item name="android:colorAccent">#FFE1A3</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#DED3E8</item>
        <item name="android:fontFamily">@font/source_sans_regular</item>
    </style>
</resources>
